rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /sensorReadings/{readingId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.resource.data.keys().hasOnly([
          "temperature",
          "humidity",
          "status",
          "uptime",
          "recordedAt",
          "source",
          "rtdbPath"
        ])
        && request.resource.data.temperature is number
        && request.resource.data.humidity is number
        && request.resource.data.recordedAt is timestamp;
      allow delete: if false;
    }
    match /alerts/{alertId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.resource.data.keys().hasOnly([
          "level",
          "title",
          "detail",
          "status",
          "occurredAt",
          "source"
        ])
        && request.resource.data.level in ["normal", "warning", "alert"]
        && request.resource.data.status in ["Normal", "Warning", "Alert"]
        && request.resource.data.occurredAt is timestamp;
      allow delete: if false;
    }
  }
}
